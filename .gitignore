# Secrets / local config
.env
.env.local
*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# Node
node_modules/

# Build / dist caches kept, but lockfile-internal caches ignored
.npm/

# pip redirect junk files (created by stray ">=x.y" install args)
=*
/400
/500

# Vendor / reference frontend builds (not part of the app; bundles contain
# a hardcoded Mapbox token, so they are excluded from the repo)
reference/

# Retired code kept locally as a backup, not part of the app
old/

# Dev agent tooling (not app code)
.agents/
.claude/

# Local working notes, not part of the repo
GUIDE.md

# Real data files must never be committed
*.xlsx

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.code-workspace

# Standalone portal prototype — not wired into app.py, not served by any route.
# Kept locally; excluded from the repo.
New Portal/

# Build caches (each project also ignores its own; these catch the rest)
.next/
*.tsbuildinfo
.mypy_cache/
.ruff_cache/

# Tooling noise
npm-debug.log*
yarn-error.log*
*.log
.write_probe

# Merge/patch leftovers
*.orig
*.rej
desktop.ini

# Local project reference material
Project Details/
