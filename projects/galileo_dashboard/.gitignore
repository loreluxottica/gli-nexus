/node_modules
/.next
*.tsbuildinfo
next-env.d.ts.bak
.DS_Store

# The prebuilt static export IS committed (Databricks Apps has no Node build
# step) — the Flask blueprint serves it. So /out is intentionally NOT ignored.

# Pipeline intermediate (regenerated by data_pipeline/run.py; not needed in git).
/data_pipeline/data/

# Derived payloads. The app fetches these from /galileo/api at runtime, built
# from the Unity Catalog tables — they are no longer imported by the frontend
# and must not come back into git, or a stale copy could be mistaken for the
# source of truth. run.py still writes them here for offline inspection.
/src/data/content.json
/src/data/db.json
/src/data/content_trends.json
/src/data/site_analysis.json
